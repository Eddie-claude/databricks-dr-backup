flowchart LR
    START([10 Restore orchestrator]) --> DATE{"backup_date<br/>renseigne ?"}
    DATE -- Non --> AUTO["Auto-detect<br/>via latest.json"]
    DATE -- Oui --> SCOPE
    AUTO --> SCOPE

    SCOPE{"restore_scope<br/>choix multiple"}

    SCOPE --> T["<b>07 Tables</b><br/>DEEP CLONE depuis<br/>incremental/ ou monthly/"]
    SCOPE --> U["<b>12 Objets UC</b><br/>Volumes + fonctions"]
    SCOPE --> V["<b>15 Fichiers des volumes</b><br/>Etat du volume a la date"]
    SCOPE --> G["<b>11 Grants</b><br/>Permissions UC<br/>GRANT statements"]
    SCOPE --> J["<b>09 Jobs</b><br/>Definitions + permissions<br/>skip ou recreate"]
    SCOPE --> N["<b>08 Notebooks</b><br/>Notebooks, fichiers, dashboards<br/>arborescence preservee"]
    SCOPE --> P["<b>13 Pipelines</b><br/>Definitions + permissions"]
    SCOPE --> A["<b>08 ACLs</b><br/>Permissions workspace<br/>dossiers, repos Git"]

    T --> SUM
    U --> SUM
    V --> SUM
    G --> SUM
    J --> SUM
    N --> SUM
    P --> SUM
    A --> SUM

    SUM["Bilan"] --> DRY{"dry_run ?"}
    DRY -- Oui --> NODRY["Simulation<br/>aucune modification"]
    DRY -- Non --> APPLIED["Modifications<br/>appliquees"]
    NODRY --> END([Fin])
    APPLIED --> END

